    <!-- Places: details of OpenStreetMap, and OpenStreetMap and Google combined. -->
    <string name="settings_places">Places</string>
    <string name="places_help">What is known of a place comes from OpenStreetMap and, when you allow it, from Google. Each can fill what the other lacks; the place says where each part came from.</string>
    <string name="places_details">Look up details in OpenStreetMap</string>
    <string name="places_details_help">Opening hours, phone, website and wheelchair access of the place you open, and the branches of the places found (\"Starbucks Shibuya\"). Sends the place you open and the places found to Nominatim.</string>
    <string name="places_combine">Combine OpenStreetMap and Google</string>
    <string name="places_combine_help">A Google search also searches OpenStreetMap, and a place of one is looked for in the other. Google is asked only while its Details of places is on.</string>
    <string name="routing_annotate">Add what offline regions know</string>
    <string name="routing_annotate_help">Speed limits, level crossings, speed cameras and junction names from your downloaded regions on the routes of Google, OSRM and Valhalla, on the phone</string>
